# ============================================================
# PlantPulse — Production Git Ignore Rules
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Sensitive Credentials
# ------------------------------------------------------------
api/cloud_config.php
.env
.env.*
!.env.example
*.local

# Private SSL Keys & Keystores (Whitelist public CA certificate)
*.key
*.pem
!isrgrootx1.pem
*.crt
!isrgrootx1.pem
*.p12
*.pfx

# ------------------------------------------------------------
# 2. Android Build, Gradle & Keystores
# ------------------------------------------------------------
android-app/.gradle/
android-app/build/
android-app/*/build/
android-app/local.properties
android-app/.idea/
android-app/*.iml
android-app/*/*.iml
android-app/**/*.apk
android-app/**/*.aab
android-app/captures/
android-app/.cxx/
android-app/.externalNativeBuild/
android-app/**/generated/

# ------------------------------------------------------------
# 3. Node.js & Web Package Managers
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ------------------------------------------------------------
# 4. PHP & Composer (Do not ignore js/vendor/)
# ------------------------------------------------------------
/vendor/
composer.phar
.phpunit.result.cache

# ------------------------------------------------------------
# 5. Python & Testing Artifacts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
scratch/
scratch_*/
test_*.php
_backup_*/
dev_tools/

# ------------------------------------------------------------
# 6. Logs & Diagnostics
# ------------------------------------------------------------
*.log
logs/
*.pid
*.seed

# ------------------------------------------------------------
# 7. Operating System & Editor Artifacts
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.bak
