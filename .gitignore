# PlantPulse — Git Ignore Rules

# 1. Environment & Sensitive Config
api/cloud_config.php
*.env
*.env.*
!.env.example

# 2. Android Build & Gradle
android-app/.gradle/
android-app/build/
android-app/*/build/
android-app/local.properties
android-app/.idea/
android-app/*.iml
android-app/**/*.apk
android-app/**/*.aab

# 3. Temporary & Scratch Test Files
scratch_test_e2e.php
test_*.php
scratch/
*.log

# 4. OS & Editor caches
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# 5. Archive & Executable files
*.zip
*.tar.gz
*.exe
Git/
